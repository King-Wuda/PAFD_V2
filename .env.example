# Supabase project — public; the publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Older projects call the same key the anon key; that name still works:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# There is deliberately no secret (service-role) key here. The app never needs one:
# reads go through RLS as anon, and the two write paths are security-definer
# functions. Do not add one to a deployment — it would hand a browser-facing
# service the power to delete history that is meant to be append-only.

# Chat import lives in a Supabase Edge Function; the model key is set with
#   supabase secrets set ANTHROPIC_API_KEY=...
# and must never appear in this file or in client code.
